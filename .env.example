# Скопируйте этот файл в .env и заполните нужное

# Порт сайта
PORT=3000

# Часовой пояс для напоминаний
TZ=Asia/Tashkent

# Пароль для входа на сайт (обязательно задайте, если выкладываете в интернет)
APP_PASSWORD=

# Токен Telegram-бота от @BotFather (необязательно, но очень рекомендую)
TELEGRAM_BOT_TOKEN=
